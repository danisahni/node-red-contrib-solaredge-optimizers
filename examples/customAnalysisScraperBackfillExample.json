  {
    "id": "caBackfillComment1",
    "type": "comment",
    "z": "8e2d41a7c3f05b96",
    "name": "Backfill past days via msg.startDate / msg.endDate (YYYY-MM-DD, UTC)",
    "info": "The regular inject fetches today. The two backfill injects set msg.startDate / msg.endDate to fetch past days, e.g. after a database outage. Without msg.endDate, data is fetched until today.\n\nLonger ranges are split into several requests automatically. Use the same Measurement Interval as for your regular data (or a separate InfluxDB measurement), since e.g. 15 minute timestamps coincide with 5 minute ones. Data that is already in InfluxDB is overwritten, not duplicated.",
    "x": 340,
    "y": 380,
    "wires": []
  },
  {
    "id": "caBackfillInjectHourly1",
    "type": "inject",
    "z": "8e2d41a7c3f05b96",
    "name": "Every Hour",
    "props": [],
    "repeat": "3600",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 200,
    "y": 440,
    "wires": [["caBackfillNode1"]]
  },
