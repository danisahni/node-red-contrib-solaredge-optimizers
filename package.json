{
  "name": "node-red-contrib-solaredge-optimizers",
  "version": "0.5.0",
  "description": "Read optimizer data from solaredge cloud",
  "main": "dist/nodes/solaredge-optimizers.js",
  "scripts": {
    "build": "tsc && copyfiles -u 2 src/nodes/*.html dist/nodes && node scripts/gen-editor-params.cjs",
    "build:watch": "tsc --watch",
    "dev": "npm run build:watch",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "node-red": "node /usr/local/lib/node_modules/node-red/red.js"
  },
  "files": [
    "dist/",
    "resources/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "node-red": {
    "version": ">=3.1.1",
    "nodes": {
      "solaredge-optimizers": "dist/nodes/solaredge-optimizers.js",
      "solaredge-diagram-data-scraper": "dist/nodes/solaredge-diagram-data-scraper.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "node-red",
    "solaredge",
    "optimizers",
    "typescript"
  ],
  "author": "Daniel Buchberger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danisahni/node-red-contrib-solaredge-optimizers.git"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^6.3.20",
    "axios": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/node-red": "^1.3.5",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
